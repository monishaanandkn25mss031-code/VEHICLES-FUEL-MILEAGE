# Backend Configuration
PORT=8000
HOST=0.0.0.0

# Supabase Credentials (Optional for local testing; SQLite fallback is used if omitted)
# Replace with your project details from Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key
# SUPABASE_SERVICE_KEY=your-supabase-service-role-key # Keep private on server only

# App Defaults
DEFAULT_CURRENCY_SYMBOL=₹
DEFAULT_CURRENCY_CODE=INR
DEFAULT_DISTANCE_UNIT=km
DEFAULT_FUEL_UNIT=litres
